#include <iostream>
using namespace std;

int main()
{
    // Display even numbers from 1 to 20,
    // skipping multiples of 4
    for (int number = 1; number <= 20; number++)
    {
        if (number % 4 == 0)
            continue;

        if (number % 2 == 0)
            cout << number << " ";
    }

    return 0;
}
