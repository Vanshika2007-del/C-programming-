#include <iostream>
using namespace std;

int main() {
    int number;
    bool isPrime = true;

    cout << "Enter number: ";
    cin >> number;

    if (number <= 1)
        isPrime = false;

    for (int i = 2; i * i <= number; i++) {
        if (number % i == 0) {
            isPrime = false;
            break;
        }
    }

    if (isPrime) cout << "Prime number";
    else cout << "Not a prime number";

    return 0;
}
