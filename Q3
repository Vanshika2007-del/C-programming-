#include <iostream>
using namespace std;

int main()
{
    int searchNumber, number;

    cout << "Enter number to search: ";
    cin >> searchNumber;

    for (number = 1; number <= 10; number++)
    {
        if (number == searchNumber)
        {
            cout << "Number found";
            break;
        }
    }

    if (number > 10)
        cout << "Number not found";

    return 0;
}
