#include <iostream>
using namespace std;

int main() {
    for (int number = 1; number <= 100; number++) {
        int temp = number, sum = 0;

        while (temp > 0) {
            sum += temp % 10;
            temp /= 10;
        }

        if (number % sum == 0)
            cout << number << " ";
    }
    return 0;
}
