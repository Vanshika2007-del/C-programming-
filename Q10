#include <iostream>
using namespace std;

int main() {
    int number, count = 0;

    while (true) {
        cout << "Enter number (0 to stop): ";
        cin >> number;

        if (number == 0)
            break;
        if (number > 0)
            count++;
    }

    cout << "Positive numbers = " << count;
    return 0;
}
