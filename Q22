#include <iostream>
using namespace std;

int main() {
    int number, temp, sum = 0;

    cout << "Enter number: ";
    cin >> number;

    temp = number;

    while (temp > 0) {
        sum += temp % 10;
        temp /= 10;
    }

    if (sum != 0 && number % sum == 0)
        cout << "Harshad number";
    else
        cout << "Not a Harshad number";

    return 0;
}
