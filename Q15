#include <iostream>
using namespace std;

int main() {
    for (int number = 1; number <= 500; number++) {
        int temp = number, sum = 0;

        while (temp > 0) {
            int digit = temp % 10;
            sum += digit * digit * digit;
            temp /= 10;
        }

        if (sum == number)
            cout << number << " ";
    }
    return 0;
}
