#include <iostream>
using namespace std;

int main() {
    int number, temp, sum = 0;

    cout << "Enter number: ";
    cin >> number;

    temp = number;

    while (temp > 0) {
        int digit = temp % 10;
        sum += digit * digit * digit;
        temp /= 10;
    }

    if (sum == number)
        cout << "Armstrong number";
    else
        cout << "Not an Armstrong number";

    return 0;
}
