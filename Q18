#include <iostream>
using namespace std;

int main() {
    int number, temp, sum = 0;

    cout << "Enter number: ";
    cin >> number;

    temp = number;

    while (temp > 0) {
        int digit = temp % 10;
        int factorial = 1;

        for (int i = 1; i <= digit; i++)
            factorial *= i;

        sum += factorial;
        temp /= 10;
    }

    if (sum == number)
        cout << "Strong number";
    else
        cout << "Not a strong number";

    return 0;
}
